{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurex-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurex-ai-db",
      "database_id": "e720a481-6f35-4ad6-88fb-dfe20d4f400b"
    }
  ]
}
